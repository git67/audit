# Environment-Datei fuer Audit-Docker-Debian.sh.
# Vor dem Audit-Lauf einlesen: source .Audit-Docker-Debian.env
# Benoetigte Variablen einkommentieren und anpassen; auskommentierte behalten die Skript-Standardwerte.

# Festes Ausgabeverzeichnis statt ./docker-audit-results-<timestamp>
# export AUDIT_OUT_DIR="/tmp/audit-app"

# Repository- oder Compose-Projektwurzel fuer Dockerfile-/Secret-/Volume-Pruefungen (Standard: .)
# export AUDIT_ROOT="/srv/app"

# Compose-Datei fuer Config-/Service-/Validierungs-Pruefungen (Standard: docker-compose.yml)
# export COMPOSE_FILE="/srv/app/docker-compose.yml"

# Lokale Image-Referenz fuer Trivy-/Grype-/Syft-SBOM- und Healthcheck-Pruefungen
# export IMAGE_NAME="myapp:1.2.3"

# Registry-Image-Referenz fuer Cosign-/Notation-/Buildx-/Skopeo-Pruefungen
# export IMAGE_REF="registry.example.com/myapp:1.2.3"

# Laufender Container fuer Laufzeit-Pruefungen
# export CONTAINER_NAME="myapp"

# Registry-Hostname fuer die Registry-Konfigurationspruefungen
# export REGISTRY_FQDN="registry.example.com"

# Registry-Repository fuer die Crane-Pruefung
# export REPOSITORY="myapp"

# Beispiel: vollstaendigen Lauf auf ein Projekt und dessen Registry-Image eingrenzen
export AUDIT_ROOT="."
# export COMPOSE_FILE="/srv/app/docker-compose.yml"
export IMAGE_NAME="alpine:latest"
export IMAGE_REF="hub.docker.com/_/alpine"
export CONTAINER_NAME="alpine"
export REGISTRY_FQDN="hub.docker.com"
export REPOSITORY="alpine"
